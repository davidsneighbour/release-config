{
  "name": "@dnbhq/release-config",
  "description": "Reusable release-it configuration for @davidsneighbour's projects.",
  "version": "1.1.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/release-config.git"
  },
  "bugs": {
    "url": "https://github.com/davidsneighbour/release-config/issues"
  },
  "homepage": "https://github.com/davidsneighbour/release-config#readme",
  "devDependencies": {
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.3",
    "release-it": "21.1.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@release-it/conventional-changelog": "^11.0.0 || ^12.0.0",
    "release-it": "^20.0.0 || ^21.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test \"src/**/*.test.ts\"",
    "release": "release-it --config .release-it.ts --ci",
    "release:force": "release-it --config .release-it.ts --ci --no-increment --no-git --no-npm --no-plugins.@release-it/conventional-changelog.infile",
    "release:config": "node src/print-config.ts --config .release-it.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0",
    "npm": ">=11.0.0"
  },
  "bin": {
    "release-config-print": "./dist/print-config.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "overrides": {
    "release-it": {
      "undici": "^7.29.1"
    },
    "get-uri": {
      "basic-ftp": "^6.2.1"
    }
  }
}
